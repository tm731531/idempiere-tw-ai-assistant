# service/.env.example
# Copy this file to .env and fill in your actual values

# LLM API keys
# ANTHROPIC_API_KEY=sk-ant-xxxx  # Claude (not needed if using Qwen)
DASHSCOPE_API_KEY=sk-xxxx  # Qwen (Alibaba DashScope - required)
GROQ_API_KEY=gsk_xxxx  # Groq Llama (required)

# Database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idempiere
DB_USER=ai_readonly
DB_PASSWORD=your-db-password

# HMAC shared secret (must match iDempiere plugin's AI_HMAC_SECRET)
HMAC_SECRET=change-me-to-a-random-string

# Service configuration
SERVICE_PORT=8900

# Mock mode (for development without token cost)
# MOCK_LLM=true  → returns canned responses, no LLM API calls, no token cost
# MOCK_LLM=false → real LLM calls (costs money, requires API keys above)
MOCK_LLM=true
